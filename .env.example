# LinkedIn app credentials are needed only for posting and engagement tools.
# Leave both values empty to use job-search tools without OAuth setup.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Optional Compose host-port overrides when the defaults are already in use.
# LINKEDIN_MCP_HOST_PORT=8000
# LINKEDIN_REDIRECT_HOST_PORT=8765

# Optional HTTP security overrides. The defaults allow local MCP clients.
# LINKEDIN_MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*
# LINKEDIN_MCP_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*
